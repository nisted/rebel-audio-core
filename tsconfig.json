{
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"compilerOptions": {
		"target": "es2024",
		"module": "node20",
		"moduleResolution": "node16",
		"lib": ["ES2024"],
		"types": ["node"],
		"strict": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedParameters": false,
		"noUnusedLocals": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true
	}
}
